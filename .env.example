# AutoHedge Environment Configuration

# Gemini API Key (Get from: https://aistudio.google.com/apikey)
# Replace with your actual Gemini API key
OPENAI_API_KEY=your-gemini-api-key-here

# Gemini API Base URL (OpenAI-compatible endpoint)
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Workspace directory for agent outputs
WORKSPACE_DIR=agent_workspace

# TROUBLESHOOTING:
# If you get "quota exceeded" error:
# 1. Get a new API key from https://aistudio.google.com/apikey
# 2. Wait for quota to reset (usually 24 hours)
# 3. Try a different model (gemini-1.5-flash instead of gemini-2.0-flash-exp)
